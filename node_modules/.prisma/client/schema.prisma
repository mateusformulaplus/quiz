// Prisma Schema for Formula Plus - Supabase PostgreSQL Database
// Configured for connection pooling & direct connection modes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AtendimentoStatus {
  AVALIACAO_INICIADA
  AVALIACAO_CONCLUIDA
  QUALIFICADO_AGUARDANDO_WHATSAPP
  WHATSAPP_INICIADO
  CONVERTIDO
  RECUPERADO_ATENDIMENTO
  DESQUALIFICADO
}

model Atendimento {
  id                  String            @id @default(cuid())
  codigoFormatado     String            @unique // Ex: #FP-1042
  nome                String
  telefone            String
  tipoFormula         String
  possuiReceita       String
  localizacao         String
  objetivo            String?
  conhecimentoFormula String?
  status              AtendimentoStatus @default(QUALIFICADO_AGUARDANDO_WHATSAPP)
  origem              String            @default("landing_page_quiz")
  ip                  String?
  userAgent           String?

  // Data e hora do clique no botão do WhatsApp
  whatsappClickedAt DateTime?

  // Data e hora em que a equipe farmacêutica realizou contato de recuperação
  recuperadoAt   DateTime?
  convertidoAt   DateTime?
  valorConversao Float?

  // Observações internas da equipe de atendimento
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([telefone])
  @@map("atendimentos")
}

model DashboardUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Equipe de Atendimento")
  role         String   @default("atendente_farmacia")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dashboard_users")
}
